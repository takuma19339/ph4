FROM php:8.1-fpm-bookworm

COPY ./docker/php/php.ini /usr/local/etc/php/
ADD ./docker/php/setup/xdebug.ini /tmp/xdebug.ini

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
     libzip-dev zlib1g-dev unzip libpq-dev libpng-dev libjpeg-dev vim git \
  && docker-php-ext-configure gd --with-jpeg \
  && docker-php-ext-install zip pcntl sockets pdo_pgsql gd \
  && pecl install xdebug \
  && docker-php-ext-enable xdebug \
  && rm -rf /var/lib/apt/lists/*

# Composer
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer
ENV COMPOSER_ALLOW_SUPERUSER=1
ENV COMPOSER_HOME=/composer
ENV PATH=$PATH:/composer/vendor/bin

COPY ./api/web /work/web
RUN mv /work/web/.env.aws /work/web/.env

RUN cd /work/web \
  && composer install \
  && chmod -R 777 ./storage \
  && ./vendor/bin/rr get-binary \
  && chmod +x ./rr

COPY ./docker/php/startup.sh /usr/local/bin/
RUN chmod 777 /usr/local/bin/startup.sh
CMD ["startup.sh"]

WORKDIR /work/web